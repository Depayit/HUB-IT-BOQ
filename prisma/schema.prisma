// HUB IT BOQ Cost Intelligence System V1.6
// PostgreSQL + Prisma 6 — table/column names match spec (@@map / snake_case fields).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum project_status {
  Active
  OnHold
  Archived
}

enum design_approval_status {
  Draft
  InReview
  Approved
  Rejected
}

enum document_status {
  Draft
  Active
  Superseded
  Archived
}

enum dependency_status {
  Pending
  Satisfied
  Waived
  NotApplicable
}

enum boq_version_status {
  Draft
  InReview
  Approved
  Locked
  Superseded
}

enum lock_status {
  Unlocked
  Locked
}

enum risk_level {
  Low
  Medium
  High
  Critical
}

enum validation_severity {
  BLOCK
  WARNING
  INFO
}

enum validation_result_status {
  Pass
  Fail
  Warning
  Overridden
}

enum approval_workflow_status {
  NotStarted
  InProgress
  Completed
  Rejected
}

enum handoff_status {
  Pending
  Completed
  Cancelled
}

enum handoff_target {
  Procurement
  Construction
  ClientHandover
}

enum edit_lock_object_type {
  boq_version
}

enum audit_action_type {
  create
  update
  delete
  approve
  reject
  lock
  override
  handoff
  correction
}

// ---------------------------------------------------------------------------
// Core project & design
// ---------------------------------------------------------------------------

model projects {
  project_id               String         @id @default(uuid()) @db.Uuid
  client_id                String?        @db.VarChar(64)
  opportunity_id           String?        @db.VarChar(64)
  project_name             String         @db.VarChar(255)
  location                 String?        @db.VarChar(255)
  project_type             String?        @db.VarChar(64)
  it_load_kw               Decimal        @db.Decimal(12, 4)
  rack_count               Int
  rack_density_kw_per_rack Decimal?       @db.Decimal(12, 4)
  tier_target              String?        @db.VarChar(32)
  sla_target               String?        @db.VarChar(64)
  currency                 String         @default("THB") @db.VarChar(8)
  vat_option               String?        @db.VarChar(32)
  project_status           project_status @default(Active)
  created_at               DateTime       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime       @updatedAt @db.Timestamptz(6)

  design_basis_versions design_basis_versions[]
  documents             documents[]
  boq_versions          boq_versions[]
  project_disciplines   project_disciplines[]
  training_records      training_records[]

  @@index([project_status])
  @@index([client_id])
  @@map("projects")
}

model design_basis_versions {
  design_basis_version_id        String                 @id @default(uuid()) @db.Uuid
  project_id                     String                 @db.Uuid
  design_version_no              Int
  it_load_assumption_kw          Decimal                @db.Decimal(12, 4)
  rack_count_assumption          Int
  rack_density_assumption        Decimal?               @db.Decimal(12, 4)
  power_architecture             String?                @db.Text
  cooling_architecture           String?                @db.Text
  fire_protection_assumption     String?                @db.Text
  monitoring_assumption          String?                @db.Text
  redundancy_assumption          String?                @db.Text
  technical_compliance_basis     String?                @db.Text
  customer_requirement_reference String?                @db.VarChar(255)
  approval_status                design_approval_status @default(Draft)
  created_at                     DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime               @updatedAt @db.Timestamptz(6)

  project projects @relation(fields: [project_id], references: [project_id], onDelete: Cascade)

  @@unique([project_id, design_version_no])
  @@index([project_id])
  @@index([approval_status])
  @@map("design_basis_versions")
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model documents {
  document_id            String          @id @default(uuid()) @db.Uuid
  project_id             String          @db.Uuid
  document_type          String          @db.VarChar(64)
  document_name          String          @db.VarChar(255)
  file_link              String?         @db.Text
  version_no             String          @db.VarChar(32)
  document_status        document_status @default(Draft)
  related_workflow_stage String?         @db.VarChar(64)
  created_at             DateTime        @default(now()) @db.Timestamptz(6)
  updated_at             DateTime        @updatedAt @db.Timestamptz(6)

  project               projects                @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  boq_version_documents boq_version_documents[]
  vendor_quotes         vendor_quotes[]
  training_records      training_records[]

  @@index([project_id])
  @@index([document_type])
  @@index([related_workflow_stage])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// BOQ versions
// ---------------------------------------------------------------------------

model boq_versions {
  boq_version_id          String             @id @default(uuid()) @db.Uuid
  project_id              String             @db.Uuid
  version_no              Int
  status                  boq_version_status @default(Draft)
  lock_status             lock_status        @default(Unlocked)
  previous_boq_version_id String?            @db.Uuid
  change_reason           String?            @db.Text
  delta_cost              Decimal?           @db.Decimal(18, 4)
  delta_selling_price     Decimal?           @db.Decimal(18, 4)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @updatedAt @db.Timestamptz(6)

  project               projects                @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  previous_boq_version  boq_versions?           @relation("BoqVersionLineage", fields: [previous_boq_version_id], references: [boq_version_id], onDelete: SetNull)
  child_boq_versions    boq_versions[]          @relation("BoqVersionLineage")
  boq_version_documents boq_version_documents[]
  project_disciplines   project_disciplines[]
  boq_lines             boq_lines[]
  validation_results    validation_results[]
  approval_workflows    approval_workflows?
  handoff_records       handoff_records[]
  boq_summary           boq_summary?

  @@unique([project_id, version_no])
  @@index([project_id])
  @@index([status])
  @@index([lock_status])
  @@index([previous_boq_version_id])
  @@map("boq_versions")
}

model boq_version_documents {
  boq_version_document_id String            @id @default(uuid()) @db.Uuid
  boq_version_id          String            @db.Uuid
  document_id             String            @db.Uuid
  dependency_type         String            @db.VarChar(64)
  is_required             Boolean           @default(true)
  dependency_status       dependency_status @default(Pending)
  created_at              DateTime          @default(now()) @db.Timestamptz(6)
  updated_at              DateTime          @updatedAt @db.Timestamptz(6)

  boq_version boq_versions @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)
  document    documents    @relation(fields: [document_id], references: [document_id], onDelete: Cascade)

  @@unique([boq_version_id, document_id])
  @@index([boq_version_id])
  @@index([dependency_status])
  @@map("boq_version_documents")
}

// ---------------------------------------------------------------------------
// Masters
// ---------------------------------------------------------------------------

model discipline_master {
  discipline_id   String   @id @default(uuid()) @db.Uuid
  discipline_code String   @unique @db.VarChar(32)
  discipline_name String   @db.VarChar(128)
  description     String?  @db.Text
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  project_disciplines project_disciplines[]

  @@map("discipline_master")
}

model cost_category_master {
  cost_category_id String   @id @default(uuid()) @db.Uuid
  category_code    String   @unique @db.VarChar(32)
  category_name    String   @db.VarChar(128)
  sort_order       Int      @default(0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @updatedAt @db.Timestamptz(6)

  boq_cost_breakdowns boq_cost_breakdowns[]

  @@map("cost_category_master")
}

// ---------------------------------------------------------------------------
// Disciplines & lines
// ---------------------------------------------------------------------------

model project_disciplines {
  project_discipline_id String     @id @default(uuid()) @db.Uuid
  project_id            String     @db.Uuid
  boq_version_id        String     @db.Uuid
  discipline_id         String     @db.Uuid
  included_flag         Boolean    @default(true)
  scope_description     String?    @db.Text
  exclusion_note        String?    @db.Text
  risk_level            risk_level @default(Medium)
  created_at            DateTime   @default(now()) @db.Timestamptz(6)
  updated_at            DateTime   @updatedAt @db.Timestamptz(6)

  project     projects          @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  boq_version boq_versions      @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)
  discipline  discipline_master @relation(fields: [discipline_id], references: [discipline_id], onDelete: Restrict)
  boq_lines   boq_lines[]

  @@unique([boq_version_id, discipline_id])
  @@index([project_id])
  @@index([boq_version_id])
  @@index([included_flag])
  @@map("project_disciplines")
}

model boq_lines {
  boq_line_id           String   @id @default(uuid()) @db.Uuid
  boq_version_id        String   @db.Uuid
  project_discipline_id String   @db.Uuid
  item_id               String?  @db.VarChar(64)
  line_no               Int
  item_description      String   @db.Text
  unit                  String   @db.VarChar(32)
  quantity              Decimal  @db.Decimal(18, 4)
  cost_source           String?  @db.VarChar(64)
  confidence_level      String?  @db.VarChar(32)
  is_critical_line      Boolean  @default(false)
  notes                 String?  @db.Text
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  boq_version         boq_versions          @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)
  project_discipline  project_disciplines   @relation(fields: [project_discipline_id], references: [project_discipline_id], onDelete: Cascade)
  boq_cost_breakdowns boq_cost_breakdowns[]
  vendor_quotes       vendor_quotes[]

  @@unique([boq_version_id, line_no])
  @@index([boq_version_id])
  @@index([project_discipline_id])
  @@index([is_critical_line])
  @@map("boq_lines")
}

model boq_cost_breakdowns {
  boq_cost_breakdown_id String   @id @default(uuid()) @db.Uuid
  boq_line_id           String   @db.Uuid
  cost_category_id      String   @db.Uuid
  calculation_method    String   @db.VarChar(64)
  base_value            Decimal  @default(0) @db.Decimal(18, 4)
  rate                  Decimal  @default(0) @db.Decimal(18, 4)
  quantity_factor       Decimal  @default(1) @db.Decimal(18, 4)
  calculated_value      Decimal  @default(0) @db.Decimal(18, 4)
  cost_source           String?  @db.VarChar(64)
  confidence_level      String?  @db.VarChar(32)
  manual_override_flag  Boolean  @default(false)
  override_reason       String?  @db.Text
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  boq_line      boq_lines            @relation(fields: [boq_line_id], references: [boq_line_id], onDelete: Cascade)
  cost_category cost_category_master @relation(fields: [cost_category_id], references: [cost_category_id], onDelete: Restrict)

  @@index([boq_line_id])
  @@index([cost_category_id])
  @@map("boq_cost_breakdowns")
}

model boq_summary {
  boq_summary_id           String   @id @default(uuid()) @db.Uuid
  boq_version_id           String   @unique @db.Uuid
  total_material_cost      Decimal  @default(0) @db.Decimal(18, 4)
  total_labor_cost         Decimal  @default(0) @db.Decimal(18, 4)
  total_logistics_cost     Decimal  @default(0) @db.Decimal(18, 4)
  total_testing_cost       Decimal  @default(0) @db.Decimal(18, 4)
  total_documentation_cost Decimal  @default(0) @db.Decimal(18, 4)
  total_indirect_cost      Decimal  @default(0) @db.Decimal(18, 4)
  total_risk_cost          Decimal  @default(0) @db.Decimal(18, 4)
  total_overhead_cost      Decimal  @default(0) @db.Decimal(18, 4)
  subtotal_before_margin   Decimal  @default(0) @db.Decimal(18, 4)
  margin_percent           Decimal  @default(15) @db.Decimal(8, 4)
  selling_price            Decimal  @default(0) @db.Decimal(18, 4)
  gross_profit             Decimal  @default(0) @db.Decimal(18, 4)
  gross_margin_percent     Decimal  @default(0) @db.Decimal(8, 4)
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @updatedAt @db.Timestamptz(6)

  boq_version boq_versions @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)

  @@index([boq_version_id])
  @@map("boq_summary")
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

model validation_rules {
  validation_rule_id String              @id @default(uuid()) @db.Uuid
  rule_code          String              @unique @db.VarChar(64)
  rule_group         String              @db.VarChar(64)
  severity           validation_severity
  target_object_type String              @db.VarChar(64)
  message            String              @db.Text
  is_active          Boolean             @default(true)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @updatedAt @db.Timestamptz(6)

  validation_results validation_results[]

  @@index([rule_group])
  @@index([severity])
  @@map("validation_rules")
}

model validation_results {
  validation_result_id String                   @id @default(uuid()) @db.Uuid
  boq_version_id       String                   @db.Uuid
  validation_rule_id   String                   @db.Uuid
  rule_code            String                   @db.VarChar(64)
  rule_group           String                   @db.VarChar(64)
  severity             validation_severity
  target_object_type   String                   @db.VarChar(64)
  target_object_id     String?                  @db.Uuid
  message              String                   @db.Text
  result_status        validation_result_status
  override_reason      String?                  @db.Text
  resolved_flag        Boolean                  @default(false)
  resolved_by          String?                  @db.VarChar(128)
  resolved_at          DateTime?                @db.Timestamptz(6)
  created_at           DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                 @updatedAt @db.Timestamptz(6)

  boq_version     boq_versions     @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)
  validation_rule validation_rules @relation(fields: [validation_rule_id], references: [validation_rule_id], onDelete: Restrict)

  @@index([boq_version_id])
  @@index([validation_rule_id])
  @@index([severity])
  @@index([result_status])
  @@index([resolved_flag])
  @@map("validation_results")
}

// ---------------------------------------------------------------------------
// Approval, handoff, locks
// ---------------------------------------------------------------------------

model approval_workflows {
  approval_workflow_id String                   @id @default(uuid()) @db.Uuid
  boq_version_id       String                   @unique @db.Uuid
  current_stage        String                   @default("Engineer Review") @db.VarChar(64)
  workflow_status      approval_workflow_status @default(NotStarted)
  engineer_reviewed_by String?                  @db.VarChar(128)
  engineer_reviewed_at DateTime?                @db.Timestamptz(6)
  manager_approved_by  String?                  @db.VarChar(128)
  manager_approved_at  DateTime?                @db.Timestamptz(6)
  director_approved_by String?                  @db.VarChar(128)
  director_approved_at DateTime?                @db.Timestamptz(6)
  final_locked_by      String?                  @db.VarChar(128)
  final_locked_at      DateTime?                @db.Timestamptz(6)
  rejection_reason     String?                  @db.Text
  created_at           DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                 @updatedAt @db.Timestamptz(6)

  boq_version boq_versions @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)

  @@index([workflow_status])
  @@index([current_stage])
  @@map("approval_workflows")
}

model handoff_records {
  handoff_id     String          @id @default(uuid()) @db.Uuid
  boq_version_id String          @db.Uuid
  handoff_status handoff_status  @default(Pending)
  handoff_target handoff_target?
  handed_off_by  String?         @db.VarChar(128)
  handoff_at     DateTime?       @db.Timestamptz(6)
  notes          String?        @db.Text
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @updatedAt @db.Timestamptz(6)

  boq_version boq_versions @relation(fields: [boq_version_id], references: [boq_version_id], onDelete: Cascade)

  @@index([boq_version_id])
  @@index([handoff_status])
  @@map("handoff_records")
}

model edit_locks {
  edit_lock_id String                @id @default(uuid()) @db.Uuid
  object_type  edit_lock_object_type
  object_id    String                @db.Uuid
  locked_by    String                @db.VarChar(128)
  locked_at    DateTime              @default(now()) @db.Timestamptz(6)
  expires_at   DateTime?             @db.Timestamptz(6)
  created_at   DateTime              @default(now()) @db.Timestamptz(6)

  @@unique([object_type, object_id])
  @@index([object_id])
  @@map("edit_locks")
}

// ---------------------------------------------------------------------------
// Vendor quotes & training
// ---------------------------------------------------------------------------

model vendor_quotes {
  vendor_quote_id       String    @id @default(uuid()) @db.Uuid
  boq_line_id           String    @db.Uuid
  vendor_name           String    @db.VarChar(255)
  price                 Decimal   @db.Decimal(18, 4)
  currency              String    @db.VarChar(8)
  valid_until           DateTime? @db.Date
  reference_document_id String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @updatedAt @db.Timestamptz(6)

  boq_line           boq_lines  @relation(fields: [boq_line_id], references: [boq_line_id], onDelete: Cascade)
  reference_document documents? @relation(fields: [reference_document_id], references: [document_id], onDelete: SetNull)

  @@index([boq_line_id])
  @@index([valid_until])
  @@map("vendor_quotes")
}

model training_records {
  training_id        String   @id @default(uuid()) @db.Uuid
  project_id         String   @db.Uuid
  session_date       DateTime @db.Date
  trainer            String   @db.VarChar(255)
  attendees          String?  @db.Text
  deliverables       String?  @db.Text
  linked_document_id String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)

  project         projects   @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  linked_document documents? @relation(fields: [linked_document_id], references: [document_id], onDelete: SetNull)

  @@index([project_id])
  @@index([session_date])
  @@map("training_records")
}

// ---------------------------------------------------------------------------
// Audit (append-only — no update/delete in application layer)
// ---------------------------------------------------------------------------

model audit_logs {
  audit_log_id  String            @id @default(uuid()) @db.Uuid
  object_type   String            @db.VarChar(64)
  object_id     String            @db.Uuid
  action_type   audit_action_type
  old_value     String?           @db.Text
  new_value     String?           @db.Text
  changed_by    String            @db.VarChar(128)
  changed_at    DateTime          @default(now()) @db.Timestamptz(6)
  change_reason String?           @db.Text

  @@index([object_type, object_id])
  @@index([changed_at])
  @@index([action_type])
  @@map("audit_logs")
}
